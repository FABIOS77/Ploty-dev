# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 16)
# When accessing from host machine:
DATABASE_URL="postgresql://ploty_user:ploty_secret@localhost:5434/ploty_db?schema=public"
# When accessing within docker-compose network:
# DATABASE_URL="postgresql://ploty_user:ploty_secret@ploty-db:5432/ploty_db?schema=public"

# Database credentials for docker-compose
POSTGRES_USER=ploty_user
POSTGRES_PASSWORD=ploty_secret
POSTGRES_DB=ploty_db
POSTGRES_EXTERNAL_PORT=5434

# Authentication (JWT)
JWT_SECRET="ploty_ultra_secure_jwt_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"
